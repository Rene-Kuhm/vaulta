{
  "name": "vaulta-repo-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Repository tooling for Vaulta (the app itself is Flutter/Dart): Conventional Commits linting and git hooks.",
  "license": "MIT",
  "scripts": {
    "commitlint": "commitlint --edit",
    "hooks:install": "lefthook install",
    "hooks:run": "lefthook run"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "lefthook": "^1.11.13"
  }
}
