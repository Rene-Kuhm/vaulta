@@ -38,6 +38,39 @@ jobs:
         # (ver docs/architecture/ADR-005-repo-hygiene.md).
         run: bash scripts/check_coverage.sh coverage/lcov.info lib/core/security 60
 
+  android-unit-tests:
+    # JVM unit tests for the native update verification core
+    # (android/app/src/test). Flutter is needed because the Gradle
+    # build resolves the Flutter SDK and plugins via `flutter pub get`.
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
+
+      - name: Set up JDK 17
+        uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3 # v4.9.1
+        with:
+          distribution: temurin
+          java-version: '17'
+          cache: gradle
+
+      - name: Set up Flutter
+        uses: subosito/flutter-action@1a449444c387b1966244ae4d4f8c696479add0b2 # v2.23.0
+        with:
+          channel: stable
+          flutter-version: 3.47.7
+          cache: true
+
+      # gradlew and gradle-wrapper.jar are gitignored (Flutter template);
+      # --config-only regenerates them plus local.properties without
+      # building an APK.
+      - name: Generate Android Gradle configuration
+        run: flutter build apk --debug --config-only
+
+      - name: Android unit tests
+        working-directory: android
+        run: ./gradlew :app:testDebugUnitTest --console=plain
+
   build-windows:
     # Build-only smoke test so Windows-specific breakage (plugins,
     # CMake, runner) is caught on the PR instead of at release time.
